<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MovieApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/color_default</item>
        <item name="colorPrimaryVariant">@color/color_default</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/color_default</item>
        <item name="colorSecondaryVariant">@color/color_default</item>
        <item name="colorOnSecondary">@color/black</item>

    </style>


    <style name="Theme.MovieApp" parent="Base.Theme.MovieApp" />


    <style name="ThemePrimaryButton">
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/custom_bg_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/urbanist_700</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ThemeSecondButton">
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/color_default</item>
        <item name="android:background">@drawable/custom_bg_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/urbanist_700</item>
        <item name="android:stateListAnimator">@null</item>
    </style>


    <style name="EditText">
        <item name="android:background">@drawable/custom_bg_edit</item>
        <item name="android:textColor">#212121</item>
        <item name="android:padding">16dp</item>
        <item name="android:fontFamily">@font/urbanist_600</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextActive">
        <item name="android:textColor">@color/color_default</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ThemeToolbarSimpleSearchView">
        <item name="android:textColorPrimary">#212121</item>
    </style>

    <style name="ToolbarTitleAppearance" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/urbanist_700</item>
    </style>

    <style name="SearchViewTheme">
        <item name="colorSecondary">#212121</item>
        <item name="searchBackground">@color/white</item>
        <item name="android:inputType">text</item>
        <item name="android:hint">@string/search_hint</item>
        <item name="hintColor">#33212121</item>
        <item name="backIconTint">#212121</item>
        <item name="android:textColor">#212121</item>
        <item name="iconsTint">#212121</item>
    </style>

    <style name="SearchViewThemeScreen" parent="Theme.AppCompat.Light.NoActionBar">
        <!--        cor do botão de apagar o texto-->
        <item name="colorControlNormal">#BDBDBD</item>
        <!--        cor do texto de dica(queryHint)-->
        <item name="android:textColorHint">#BDBDBD</item>
        <!--        cor do texto digitado-->
        <item name="android:editTextColor">#212121</item>
        <!--        font do texto-->
        <item name="android:fontFamily">@font/urbanist_400</item>
        <!--        tamanho do texto-->
        <item name="android:textSize">14sp</item>
        <!--        cor do cursor-->
        <item name="colorControlActivated">#212121</item>
        <!--        tipo do texto-->
        <item name="android:inputType">textCapSentences</item>
    </style>

    <style name="CustomAlertDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>

    <style name="BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/bottomSheetStyleWrapper</item>
    </style>

    <style name="bottomSheetStyleWrapper" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>