<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MovieApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/color_default</item>
        <item name="colorPrimaryVariant">@color/color_default</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/color_default</item>
        <item name="colorSecondaryVariant">@color/color_default</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Theme.MovieApp" parent="Base.Theme.MovieApp" />
    
    
    <style name="ButtonDefault">
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/custom_bg_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/urbanist_700</item>
    </style>


    <style name="EditText">
        <item name="android:background">@drawable/custom_bg_edit</item>
        <item name="android:textColor">#212121</item>
        <item name="android:padding">16dp</item>
        <item name="android:fontFamily">@font/urbanist_600</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="TextActive">
        <item name="android:textColor">@color/color_default</item>
        <item name="android:elevation">70dp</item>
    </style>
</resources>